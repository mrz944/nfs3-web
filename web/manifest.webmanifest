{
  "name": "NFS3 Hot Pursuit",
  "short_name": "NFS3",
  "description": "Need for Speed III: Hot Pursuit recompiled to run in your browser, with online multiplayer.",
  "start_url": "/",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#010622",
  "theme_color": "#030b3d",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
